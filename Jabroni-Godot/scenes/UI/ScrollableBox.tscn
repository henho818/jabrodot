[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/UI/Dialog/ScrollableBox.cs" id="1_scrollablebox"]
[ext_resource type="PackedScene" path="res://scenes/UI/DialogBox.tscn" id="2_dialogbox"]

[node name="ScrollableBox" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("1_scrollablebox")

; First child, so Portrait and Mask sit above it and win hit-testing -- a tap on a line must
; reach the line, not be eaten by the backdrop behind it. mouse_filter 0 (STOP) is what makes
; everything else that lands on the darkened region stop here instead of reaching the world.
[node name="Backdrop" type="ColorRect" parent="."]
mouse_filter = 0
color = Color(0, 0, 0, 0.45)

[node name="Portrait" type="TextureRect" parent="."]
custom_minimum_size = Vector2(96, 96)
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Mask" type="ScrollContainer" parent="."]
clip_contents = true
horizontal_scroll_mode = 0
follow_focus = false

[node name="DialogBox" parent="Mask" instance=ExtResource("2_dialogbox")]
layout_mode = 2
